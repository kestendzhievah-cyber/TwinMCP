# ---------------------------------------------------------------------------
# TwinMCP environment variables
#
# Copy to apps/backend/.env.local for local dev. In production these are set as
# the Dokploy project environment (runtime) — and the NEXT_PUBLIC_* ones must
# ALSO be passed as Docker build args (see docker-compose.yml), because Next.js
# inlines them at build time.
#
# `pnpm --filter @twinmcp/backend check-env` validates this contract.
# Replace "twinmcp.fr" everywhere with your real production domain.
# ---------------------------------------------------------------------------

# --- Public URLs -----------------------------------------------------------
# Public origin of the control plane (used for OAuth issuer, QStash callbacks,
# absolute links). Use ONE domain consistently across every URL below.
APP_URL=https://twinmcp.fr
NEXT_PUBLIC_SITE_URL=https://twinmcp.fr
NEXT_PUBLIC_APP_URL=https://twinmcp.fr
TWINMCP_API_URL=https://twinmcp.fr/api
RESOURCE_URL=https://twinmcp.fr
AUTH_SERVER_URL=https://twinmcp.fr
# Allowed CORS origin for /api/* (next.config.mjs falls back to "*" if unset —
# always set this to your real origin in production).
CORS_ORIGIN=https://twinmcp.fr

# --- Postgres (Supabase) — REQUIRED for boot -------------------------------
# Transaction pooler (port 6543, PgBouncer) — runtime / serverless
DATABASE_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1
# Direct connection (port 5432) — migrations only
DATABASE_URL_UNPOOLED=postgres://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Optional — only if you use Supabase Storage / service-role from the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Auth (client) — REQUIRED for boot ----------------------------
# These are also Docker BUILD ARGS (inlined into the client bundle).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Config encryption (MCP secrets) — REQUIRED for the core feature -------
# 32 bytes hex (64 chars). Generate with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# --- MCP runtime (Upstash Box) — REQUIRED for the core feature -------------
# Without this, server provisioning runs in stub mode in dev and REFUSES to run
# in production (getBoxClient throws). Get it from the Upstash Box dashboard.
UPSTASH_BOX_API_KEY=box_...

# --- Job queue (Upstash QStash) — recommended in prod ----------------------
# Durable provisioning with retries. On the long-lived VPS container, omitting
# these falls back to in-process inline execution (fine while the container
# stays up; jobs in flight are lost on restart). APP_URL must be the public URL.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Rate-limiting + cache (Upstash Redis REST) ----------------------------
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# --- OAuth 2.1 (MCP HTTP transport) — OPTIONAL, opt-in ---------------------
# Default MCP auth is the ctx7sk_ API key (Bearer). OAuth endpoints + discovery
# are disabled unless OAUTH_ENABLED=1. The current OAuth stores are in-memory
# (not persisted) — keep this off until they are DB-backed.
OAUTH_ENABLED=
# Only needed if OAUTH_ENABLED=1. RSA keypair (PEM):
# openssl genrsa -out k.pem 2048 && openssl rsa -in k.pem -pubout
OAUTH_ISSUER=https://twinmcp.fr
OAUTH_JWT_PRIVATE_KEY=
OAUTH_JWT_PUBLIC_KEY=

# --- Billing (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (start with "price_", NOT "pi_"). Names MUST match lib/stripe.ts.
# Pro monthly is required for checkout; the others are optional (enable as you
# add cadences/plans). Get them from Stripe → Product → Pricing.
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...
STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
STRIPE_TEAM_YEARLY_PRICE_ID=price_...
# Publishable key (client bundle / build arg). Optional unless you mount Stripe
# Elements client-side; Checkout redirect does not require it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Free trial duration in days (0 = no trial). Applied to all subscriptions.
TRIAL_DAYS=14

# --- AI (OpenAI) -----------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ingestion worker (apps/ingest) ----------------------------------------
# Personal access token with `public_repo` scope (bumps rate limit 60→5000/h)
GITHUB_TOKEN=
# Full redis:// URL for BullMQ (distinct from the Upstash REST pair above).
# Upstash exposes both — use the "Redis Connect" TCP URL here.
REDIS_URL=
INGEST_CONCURRENCY=2

# --- Security --------------------------------------------------------------
# 64 hex chars (32 bytes), generate with: openssl rand -hex 32
CLIENT_IP_ENCRYPTION_KEY=
# DEV ONLY. Accepts an X-TwinMCP-User-Id header as a session bypass.
# MUST be absent or "0" in production (otherwise MCP proxy auth is bypassable).
TWINMCP_ALLOW_DEV_AUTH=

# --- Object storage (Cloudflare R2 or S3) — optional -----------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=twinmcp-docs
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Email (Resend) — optional ---------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@twinmcp.fr

# --- Observability — optional ----------------------------------------------
SENTRY_DSN=
# Public DSN + source-map upload (build args).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
AXIOM_TOKEN=
AXIOM_DATASET=twinmcp

# --- Funnel analytics (PostHog) — optional (build args) --------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- SEO verification — optional (build args) ------------------------------
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# IndexNow instant indexing key (Bing/Yandex). Optional.
INDEXNOW_KEY=

# --- Rate limits (defaults if unset) ---------------------------------------
RATE_LIMIT_FREE_DAILY=50
RATE_LIMIT_PRO_DAILY=10000
