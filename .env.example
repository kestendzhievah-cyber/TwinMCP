# =============================================================================
# TwinMCP backend — environment TEMPLATE
# =============================================================================
# HOW TO USE
#   1. Copy the lines below into Dokploy (App → Environment → Variables).
#   2. Fill each value there — NEVER put real secrets in this file.
#   3. This file is committed to git (it's a template), so it must contain
#      placeholders ONLY. Real secrets live in Dokploy.
#
# Generate a 32-byte hex key with:   openssl rand -hex 32
# Legend:  [REQUIRED] app won't work without it   [OPT] optional / degrades gracefully
# =============================================================================

NODE_ENV=production

# --- Database (Supabase Postgres) — [REQUIRED, boot] -------------------------
# Supabase → Project Settings → Database → Connection string.
# POOLED uses port 6543 (app runtime), UNPOOLED uses 5432 (migrations).
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:6543/postgres
DATABASE_URL_UNPOOLED=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# --- Auth (Supabase) — [REQUIRED, boot] --------------------------------------
# Supabase → Project Settings → API. URL + publishable key = the SAME project
# as the database above. service_role is the long secret JWT (starts eyJ...),
# NOT a publishable key — required for GDPR account deletion.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...service_role...

# --- MCP runtime (Upstash Box) — [REQUIRED for the core feature] -------------
# Upstash Console → Box → API Keys. Without it, provisioning refuses in prod.
UPSTASH_BOX_API_KEY=box_xxx

# --- Config + IP encryption — [REQUIRED] -------------------------------------
# Both are 32-byte hex (64 chars). Generate each: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32
CLIENT_IP_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# --- Rate limiting (Upstash Redis REST) — [REQUIRED] -------------------------
# Upstash Console → Redis → REST API. NOT the redis:// URL.
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# --- Billing (Stripe) — [REQUIRED for checkout/webhooks] ---------------------
# Stripe Dashboard → Developers → API keys / Webhooks / Products.
# Team price IDs are needed for the Team plan checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# The webhook endpoint must send every event the code handles. Check / fix it
# with the live key: `pnpm --filter @twinmcp/backend stripe:webhook` (dry run),
# then `… stripe:webhook --apply` (adds the missing events, never removes any).
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_YEARLY_PRICE_ID=price_xxx
STRIPE_TEAM_MONTHLY_PRICE_ID=price_xxx
STRIPE_TEAM_YEARLY_PRICE_ID=price_xxx
# Pro trial length in days on a FIRST subscription. Defaults to PRO_TRIAL_DAYS (30) in
# src/lib/plan-features.ts, which the marketing copy advertises ("first month free").
# Only set this to override, e.g. TRIAL_DAYS=0 to disable the trial everywhere.
# TRIAL_DAYS=30
# Optional: pre-applies a creator/influencer promo code (promo_xxx) at checkout.
STRIPE_PROMO_YOUTUBER_ID=promo_xxx
# [OPT] Wallet top-ups: tax handling when STRIPE_TAX_ENABLED=true.
# exclusive (default) = €10 of credit costs €10 + VAT; inclusive = €10 charged,
# credit = €10 minus the VAT in it. Have the accountant confirm before changing.
# WALLET_TOPUP_TAX_BEHAVIOR=exclusive
# STRIPE_TOPUP_TAX_CODE=txcd_xxxxxxxx

# --- Prepaid wallet (pay-as-you-go) — [recommended] --------------------------
# Keyed pepper for the hashed e-mail of sign-up-credit claims (the €10
# anti-abuse table). Falls back to CONFIG_ENCRYPTION_KEY when unset. Set it
# BEFORE the first claim and NEVER change it: a new pepper makes every past
# claim unrecognisable (one more €10 per user). If claims already exist under
# the fallback, set it to the CURRENT CONFIG_ENCRYPTION_KEY value instead.
# Generate: openssl rand -hex 32
SIGNUP_HASH_PEPPER=REPLACE_WITH_openssl_rand_hex_32
# Destructive enforcement: only when exactly "true" are the deletion warnings
# (day 0/7/13) sent and the RUNTIME (box only, configs kept) of an expired,
# never-funded account deleted on day 14. Pausing at €0 always applies.
# WALLET_ENFORCE_ENABLED=true
# Promo compute kill switch: caps on the compute a promo-only account burns,
# in REAL-cost euros (before the multiplier). Defaults: 20% / 90% of the €10
# credit's real cost (€0.20 per UTC day, €0.90 in total with ×10). A value that
# is not a positive number falls back to its default; the daily cap is clamped
# to the total. Over a cap the account's boxes are paused and it is flagged.
# WALLET_PROMO_DAILY_COST_CAP_EUR=0.20
# WALLET_PROMO_TOTAL_COST_CAP_EUR=0.90
# Price = real cost × multiplier (min 1). Changing it re-prices everything.
# WALLET_COST_MULTIPLIER=10
# USD → EUR rate applied to Upstash's USD prices.
# WALLET_USD_EUR=0.92
# Real cost of 1,000 proxied MCP calls, in EUR (×multiplier = billed price).
# WALLET_CALL_COST_EUR_PER_1000=0.01
# Sign-up credit anti-abuse limits (claims per rolling 24 h).
# SIGNUP_CREDIT_MAX_PER_IP_DAY=3
# SIGNUP_CREDIT_MAX_PER_SUBNET_DAY=10
# SIGNUP_CREDIT_MAX_PER_DAY=200
# Tool calls per user per minute before the MCP proxy answers 429.
# MCP_CALLS_PER_MINUTE=600

# --- Admin analytics — [recommended] -----------------------------------------
# Comma-separated allowlist of emails that can see the /dashboard/admin
# platform-wide analytics (users, MRR, traffic…). If unset, it falls back to a
# built-in founder email; set this to lock admin access to your own account(s).
ADMIN_EMAILS=you@example.com

# --- Public URLs / CORS — [recommended] --------------------------------------
# Your real domain. CORS_ORIGIN locks cross-origin; falls back to '*' if unset.
NEXT_PUBLIC_SITE_URL=https://twinmcp.fr
CORS_ORIGIN=https://twinmcp.fr
# [OPT] How the app reaches its own API from inside the container (the
# twinmcp-docs MCP calls /api/v2/context). Defaults to http://127.0.0.1:$PORT;
# never derived from request headers.
# INTERNAL_BASE_URL=http://127.0.0.1:3000

# --- Job queue (Upstash QStash) — [OPT] --------------------------------------
# If unset, provisioning runs inline (fine on a long-lived VPS). Set all four
# to make jobs durable + retryable. APP_URL is your backend's public URL.
# QSTASH_TOKEN=xxx
# QSTASH_CURRENT_SIGNING_KEY=xxx
# QSTASH_NEXT_SIGNING_KEY=xxx
# APP_URL=https://twinmcp.fr

# --- Context / library search (OpenAI) — [OPT] -------------------------------
# Only needed for /api/v2/context semantic search + doc embeddings.
# OPENAI_API_KEY=sk-xxx
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Analytics (PostHog EU) — [OPT] ------------------------------------------
# Enables funnel events. Analytics cookies fire only AFTER cookie consent.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Observability (Sentry) — [OPT] ------------------------------------------
# SENTRY_DSN=https://xxx.ingest.sentry.io/xxx
# NEXT_PUBLIC_SENTRY_DSN=https://xxx.ingest.sentry.io/xxx

# --- Transactional email (Resend) — [OPT] ------------------------------------
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=TwinMCP <hello@twinmcp.fr>
# Upgrade nudge emails (/api/cron/nudges, QStash job "upgrade-nudges") are
# silent no-ops without RESEND_API_KEY: nothing is sent and nothing is stamped.

# --- OAuth 2.1 for remote MCP connectors (Claude, ChatGPT…) — [OPT] ---------
# ON by default (no keys needed: tokens are random values stored hashed).
# Kill switch: OAUTH_DISABLED=1 → every /oauth/* and discovery endpoint 404s
# and issued tokens stop working; ctx7sk_ API keys are unaffected.
# OAUTH_DISABLED=1
# Issuer URL (falls back to NEXT_PUBLIC_SITE_URL, then https://twinmcp.fr).
# OAUTH_ISSUER=https://twinmcp.fr

# --- Scheduled jobs (/api/cron/*) — [OPT] -------------------------------------
# An in-process scheduler (src/lib/scheduler) runs every job below from the app
# container itself: ON by default when NODE_ENV=production (needs DATABASE_URL),
# so an EXTERNAL cron (Dokploy schedule, cron-job.org, QStash schedules) is now
# OPTIONAL. /api/health reports the scheduler's state.
#   INTERNAL_SCHEDULER=1        turn it on (the production Docker image sets this;
#                               a local `next start` never runs billing jobs)
#   INTERNAL_SCHEDULER=0        turn it off (e.g. an external scheduler calls /api/cron/*)
#   INTERNAL_SCHEDULER_SKIP=…   comma-separated job names to skip, e.g. digest,churn
# INTERNAL_SCHEDULER=0
# INTERNAL_SCHEDULER_SKIP=digest,churn
#
# CRON_SECRET: Bearer token for /api/cron/* (needed only by an external
# scheduler; admins can also trigger each job from a signed-in session).
# CRON_SECRET=xxx
#
# What the in-app scheduler runs (UTC), i.e. what an external one must call if
# INTERNAL_SCHEDULER=0 (POST, or GET, with "Authorization: Bearer $CRON_SECRET"):
#   every 5 min   /api/cron/meter-boxes       compute billing: WITHOUT it box time is never billed
#   every 10 min  /api/cron/wallet-enforce    pause at €0, promo kill switch, auto-recharge retries
#   hourly        /api/cron/wallet-expiry     write off expired promo credit
#   03:30 daily   /api/cron/purge             retention purge: activity (Free 7 d / Pro 90 d), audit, webhook deliveries
#   07:00 daily   /api/cron/digest            admin digest
#   08:00 daily   /api/cron/wallet-reminders  low balance / expiry / deletion-warning emails
#   08:10 daily   /api/cron/churn             churn report
#   09:00 daily   /api/cron/nudges            upgrade nudge emails (needs RESEND_API_KEY)

# --- Tool-call activity log — [OPT] -------------------------------------------
# ACTIVITY_LOG_DISABLED=1   # stop recording tool calls (metadata only)
# ACTIVITY_FLUSH_MS=1000    # batch flush interval; 0 writes each row at once
# ACTIVITY_FLUSH_BATCH=50   # flush as soon as this many rows are buffered

# --- Outbound webhooks — [OPT] ------------------------------------------------
# Dev only (ignored when NODE_ENV=production): allow localhost/private receivers.
# WEBHOOKS_ALLOW_PRIVATE=1
# Extra addresses webhooks may never target (CIDRs or IPs, comma-separated):
# put the VPS's public IPv4/IPv6 here. TwinMCP's own domain addresses are
# denied automatically; set WEBHOOKS_DENY_SELF=0 only if the domain is ever
# fronted by a shared CDN (its anycast IPs also serve customers' receivers).
# WEBHOOKS_DENY_CIDRS=203.0.113.10,2001:db8::/64
# WEBHOOKS_DENY_SELF=0

# --- Google Ads conversions — [OPT, BUILD-TIME] ------------------------------
# send_to values ("AW-…/label") from Google Ads → Goals → Conversions. They are
# NEXT_PUBLIC_* (inlined at build): set them as GitHub Actions repository
# VARIABLES, which deploy.yml passes as build args. Conversions fire only after
# advertising consent. Empty = that conversion is a no-op, except TOPUP: empty
# makes paid top-ups report to the "Abonnement" action.
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_SEND_TO=AW-xxx/xxx
# NEXT_PUBLIC_GOOGLE_ADS_DEMO_SEND_TO=AW-xxx/xxx
# "Recharge" (paid wallet top-up; value net of VAT, EUR, transaction_id = the
# Checkout session id):
# NEXT_PUBLIC_GOOGLE_ADS_TOPUP_SEND_TO=AW-xxx/xxx

# --- SEO verification — [OPT] ------------------------------------------------
# NEXT_PUBLIC_GSC_VERIFICATION=xxx
# NEXT_PUBLIC_BING_VERIFICATION=xxx
# INDEXNOW_KEY=xxx

# --- Public links & CLI package — [OPT] --------------------------------------
# Rendered only when set (lib/site-links.ts). Set them only for pages that exist.
# NEXT_PUBLIC_STATUS_URL=https://status.twinmcp.fr
# NEXT_PUBLIC_TWITTER_URL=https://x.com/<handle>
# NEXT_PUBLIC_GITHUB_URL=https://github.com/<org>/<repo>
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/<slug>
# npm package the dashboard tells local-agent users to run (lib/cli.ts).
# NEXT_PUBLIC_TWINMCP_CLI_PACKAGE=@twinmcp/cli

# =============================================================================
# NOTE: NEXT_PUBLIC_* vars are inlined at BUILD time. Dokploy must pass them as
# build args (or rebuild the image) for them to take effect in the browser.
# The ingestion worker (apps/ingest) has its own vars (GITHUB_TOKEN, REDIS_URL,
# BullMQ) — not needed to run the backend/dashboard.
# =============================================================================
